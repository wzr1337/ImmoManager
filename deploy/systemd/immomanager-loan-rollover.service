[Unit]
Description=ImmoManager monthly loan ledger rollover (projected Kontoauszug entries)

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/source/ImmoManager
EnvironmentFile=/home/pi/source/ImmoManager/.env
ExecStart=/home/pi/source/ImmoManager/.venv/bin/python -m scripts.roll_loan_ledger
StandardOutput=append:/home/pi/source/ImmoManager/logs/loan-rollover.log
StandardError=append:/home/pi/source/ImmoManager/logs/loan-rollover-error.log
