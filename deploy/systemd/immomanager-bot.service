[Unit]
Description=ImmoManager Telegram Bot - Nebenkostenabrechnung invoice intake
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/source/ImmoManager
EnvironmentFile=/home/pi/source/ImmoManager/.env
ExecStart=/home/pi/source/ImmoManager/.venv/bin/python -m bot.main

Restart=always
RestartSec=10

StandardOutput=append:/home/pi/source/ImmoManager/logs/service.log
StandardError=append:/home/pi/source/ImmoManager/logs/service-error.log

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
