# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to talk to the bot. Required — the
# bot refuses to start without this set, since it handles tenant financial data.
TELEGRAM_ALLOWED_CHAT_IDS=

# Anthropic API key, used only for one-shot invoice OCR/extraction.
ANTHROPIC_API_KEY=

# Path to the SQLite database file. Defaults to data/immomanager.db if unset.
IMMOMANAGER_DB_PATH=

# Root directory for invoice scans, generated documents, and live templates.
# Defaults to data/ if unset.
IMMOMANAGER_DATA_DIR=
