# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to talk to the bot. Required — the
# bot refuses to start without this set, since it handles tenant financial data.
TELEGRAM_ALLOWED_CHAT_IDS=

# AWS credentials for Bedrock, used only for one-shot invoice OCR/extraction.
# The IAM user needs bedrock:InvokeModel on the model and its EU inference profile only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# EU inference profile keeps invoice data in EU regions. Defaults to Sonnet 4.6.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6

# Path to the SQLite database file. Defaults to data/immomanager.db if unset.
IMMOMANAGER_DB_PATH=

# Root directory for invoice scans, generated documents, and live templates.
# Defaults to data/ if unset.
IMMOMANAGER_DATA_DIR=
